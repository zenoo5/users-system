{
  "name": "node-task-manager",
  "version": "1.0.0",
  "description": "An asynchronous in-memory task manager built with Node.js, TypeScript, and ES modules",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
